exports[`StatusPanel static markup (pre-migration baseline) > renders resource bars, traffic, NIC options, and the processes view 1`] = `"<div class="@container flex h-full min-h-0 flex-col bg-panel text-xs"><header class="flex h-8 shrink-0 items-center gap-2 border-b border-border bg-surface px-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-3.5 w-3.5 shrink-0 text-muted" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg><h3 class="shrink-0 text-xs font-semibold text-text">Server Status</h3><div class="ml-auto flex shrink-0 items-center gap-0.5"><div class="flex items-center gap-2"><span class="hidden items-center gap-1 text-[11px] text-muted tabular-nums @xs:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock3 lucide-clock-3 h-3 w-3" aria-hidden="true"><path d="M12 6v6h4"></path><circle cx="12" cy="12" r="10"></circle></svg>4:00:00 PM</span><div role="group" class="inline-flex shrink-0 items-center gap-0.5 rounded-md border border-border bg-surface p-0.5"><button type="button" class="inline-flex items-center gap-1.5 rounded-[4px] whitespace-nowrap transition-colors duration-150 h-5 px-1.5 text-[11px] text-muted hover:text-text" aria-pressed="false" title="Refresh every 3s">3s</button><button type="button" class="inline-flex items-center gap-1.5 rounded-[4px] whitespace-nowrap transition-colors duration-150 h-5 px-1.5 text-[11px] bg-elevated font-medium text-text shadow-[0_1px_2px_rgba(0,0,0,0.12)] ring-1 ring-border" aria-pressed="true" title="Refresh every 5s">5s</button><button type="button" class="inline-flex items-center gap-1.5 rounded-[4px] whitespace-nowrap transition-colors duration-150 h-5 px-1.5 text-[11px] text-muted hover:text-text" aria-pressed="false" title="Refresh every 10s">10s</button></div></div></div></header><div class="flex min-h-0 flex-1 flex-col"><div class="grid shrink-0 grid-cols-1 gap-3 border-b border-border px-3 py-2.5"><div><div class="mb-1.5 flex items-center justify-between gap-2"><span class="inline-flex items-center gap-1.5 text-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu h-3.5 w-3.5" aria-hidden="true"><path d="M12 20v2"></path><path d="M12 2v2"></path><path d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path d="M20 12h2"></path><path d="M20 17h2"></path><path d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>CPU</span><span class="font-medium text-text tabular-nums">12.50%</span></div><div class="h-1 overflow-hidden rounded-full bg-warm"><div class="h-full rounded-full transition-[width] duration-300 bg-accent" style="width:12.5%"></div></div></div><div><div class="mb-1.5 flex items-center justify-between gap-2"><span class="inline-flex items-center gap-1.5 text-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-memory-stick h-3.5 w-3.5" aria-hidden="true"><path d="M12 12v-2"></path><path d="M12 18v-2"></path><path d="M16 12v-2"></path><path d="M16 18v-2"></path><path d="M2 11h1.5"></path><path d="M20 18v-2"></path><path d="M20.5 11H22"></path><path d="M4 18v-2"></path><path d="M8 12v-2"></path><path d="M8 18v-2"></path><r