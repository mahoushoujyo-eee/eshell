exports[`StatusPanel static markup (pre-migration baseline) > renders the empty state with the default 5s interval active 1`] = `"<div class="flex h-full min-h-0 flex-col bg-panel text-xs"><div class="flex items-center justify-between border-b border-border px-2 py-2"><div class="inline-flex items-center gap-2 text-sm font-semibold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-4 w-4 text-accent" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>Server Status</div><div class="flex items-center gap-2"><div class="inline-flex rounded border border-border"><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r text-muted hover:bg-accent-soft/70" title="Refresh every 1s">1s</button><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r text-muted hover:bg-accent-soft/70" title="Refresh every 3s">3s</button><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r bg-accent text-white" title="Refresh every 5s">5s</button><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r text-muted hover:bg-accent-soft/70" title="Refresh every 10s">10s</button></div></div></div><div class="flex flex-1 items-center justify-center text-muted">No status data</div></div>"`;

