p-0.5 text-[10px] font-medium text-muted hover:text-foreground">Size<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-up-down h-3 w-3 opacity-30" aria-hidden="true"><path d="m7 15 5 5 5-5"></path><path d="m7 9 5-5 5 5"></path></svg></button><button type="button" class="flex w-20 shrink-0 items-center justify-end gap-0.5 text-[10px] font-medium text-muted hover:text-foreground">Modified<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-up-down h-3 w-3 opacity-30" aria-hidden="true"><path d="m7 15 5 5 5-5"></path><path d="m7 9 5-5 5 5"></path></svg></button></div><div class="min-h-0 flex-1 overflow-auto bg-surface/20"><div class="py-8 text-center text-[10px] text-muted/50">Empty directory</div></div></div></div></div></div></div>"`;

exports[`StatusPanel static markup (pre-migration baseline) > renders resource bars, traffic, NIC options, and the processes view 1`] = `"<div class="flex h-full min-h-0 flex-col bg-panel text-xs"><div class="flex items-center justify-between border-b border-border px-2 py-2"><div class="inline-flex items-center gap-2 text-sm font-semibold"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-4 w-4 text-accent" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>Server Status</div><div class="flex items-center gap-2"><div class="inline-flex rounded border border-border"><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r text-muted hover:bg-accent-soft/70" title="Refresh every 1s">1s</button><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r text-muted hover:bg-accent-soft/70" title="Refresh every 3s">3s</button><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r bg-accent text-white" title="Refresh every 5s">5s</button><button type="button" class="px-1.5 py-0.5 text-[10px] font-medium transition-colors first:rounded-l last:rounded-r text-muted hover:bg-accent-soft/70" title="Refresh every 10s">10s</button></div><span class="inline-flex items-center gap-1 text-muted"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock3 lucide-clock-3 h-3.5 w-3.5" aria-hidden="true"><path d="M12 6v6h4"></path><circle cx="12" cy="12" r="10"></circle></svg>4:00:00 PM</span></div></div><div class="flex min-h-0 flex-1 flex-col"><div class="border-b border-border bg-surface/40 px-2 py-2"><div class="mb-1 flex justify-between"><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu h-3.5 w-3.5 text-accent" aria-hidden="true"><path d="M12 20v2"></path><path d="M12 2v2"></path><path d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path d="M20 12h2"></path><path d="M20 17h2"></path><path d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>CPU</span><span>12.50%</span></div><div class="h-2 bg-warm"><div class="h-full bg-accent" style="width:12.5%"></div></div><div class="mt-2 mb-1 flex justify-between"><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server h-3.5 w-3.5 text-success" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>Memory (GB)</span><span>2.00 / 8.00 GB</span></div><div class="h-2 bg-warm"><div class="h-full bg-success" style="width:25%"></div></div></div><div class="border-b border-border bg-surface/30 px-2 py-2"><div class="mb-1 flex items-center justify-between"><span class="inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap