{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eshell",
  "version": "1.5.3",
  "identifier": "com.eee.eshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "eshell",
        "width": 1200,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 700,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OTI2REVDNTlBRTBEOTMKUldTVERhNVo3RzJTUlFjeUxvcDBrN2luZlRaaUNXbWZBZHY1eW5idGo4Q3duRVNKSE5IS0h5ZmcK",
      "endpoints": [
        "https://github.com/mahoushoujyo-eee/eshell/releases/latest/download/latest.json"
      ]
    }
  }
}
